{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "FyM.Users.Api",
    "Audience": "FyM.Users.Client",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "AllowSelfRegistration": true
  },
  "Seed": {
    "SuperAdmin": {
      "UserName": "superadmin",
      "Email": "admin@fymtechnology.com",
      "Password": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Cookies": {
    "Secure": true
  },
  "Database": {
    "AutoMigrate": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fym-users-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
