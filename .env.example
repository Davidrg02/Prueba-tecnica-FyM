# Copiar este archivo a ".env" antes de levantar el proyecto:
#   cp .env.example .env
#
# Todos los valores de ejemplo son evidentemente de desarrollo. Cámbielos
# antes de exponer el sistema fuera de un entorno local/de demostración.

# --- SQL Server ---
MSSQL_SA_PASSWORD=Your_password123!

# --- API / JWT ---
# Debe tener al menos 32 caracteres. Genere uno propio, por ejemplo con:
#   openssl rand -base64 48
JWT_KEY=change-this-to-a-random-string-of-at-least-32-bytes-long
JWT_ISSUER=FyM.Users.Api
JWT_AUDIENCE=FyM.Users.Client

# --- Super administrador precreado ---
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_EMAIL=admin@fymtechnology.com
SEED_SUPERADMIN_PASSWORD=Adm1n#FyM2026*

# --- CORS / cookies ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
# En local sobre HTTP debe ser "false"; en producción sobre HTTPS use "true".
COOKIES_SECURE=false

# --- Frontend ---
# Ruta relativa que Nginx usa para redirigir hacia la API. No cambiar salvo
# que también se ajuste infra/nginx/default.conf.
API_BASE_URL=/api

# --- Puertos publicados en el host ---
WEB_PORT=4200
API_PORT=8080
SQL_PORT=1433
